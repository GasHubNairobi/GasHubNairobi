# ===========================================================================
# GasHub environment variables
#   Local:   copy this file to ".env" (never commit or share it).
#   Netlify: add each of these in  Site configuration -> Environment variables  (do NOT upload a .env file).
# ===========================================================================

# ---- Supabase (PostgreSQL) ---------------------------------------------------
# On Netlify use Supabase's CONNECTION POOLER (Supabase dashboard -> Connect -> "Transaction pooler"):
#   DB_HOST = aws-0-<region>.pooler.supabase.com     DB_PORT = 6543     DB_USER = postgres.<your-project-ref>
# (Locally you can use the direct connection: db.<ref>.supabase.co, port 5432, user postgres.)
# Alternatively set DATABASE_URL to the full pooler connection string and leave DB_HOST/PORT/USER/PASSWORD out.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Security (REQUIRED on Netlify) -------------------------------------------
# A long random value, e.g. run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-value

# ---- Your public website address (REQUIRED on Netlify) --------------------------
# Used in emails, share previews, Google/Facebook/X sign-in redirects and delivery links. No trailing slash.
PUBLIC_URL=https://your-site.netlify.app
# (APP_BASE_URL below must be the same address)

# Copy this file to .env and fill in your own Supabase PostgreSQL connection values.
DB_HOST=your-supabase-db-host
DB_PORT=5432
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=postgres
PORT=3000

# SMTP email delivery for approved dealer applications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=GasHub <no-reply@example.com>
APP_BASE_URL=https://your-site.netlify.app      # locally: http://localhost:3000

# SMS (admin "SMS Broadcast" + automated SMS reminders) - Africa's Talking
SMS_PROVIDER=africastalking
AT_USERNAME=your-africastalking-username
AT_API_KEY=your-africastalking-api-key
AT_SENDER_ID=
AT_SANDBOX=false


# ---------------------------------------------------------------------------
# M-PESA PAYMENTS (Safaricom Daraja STK Push) - fill these in when your Daraja account is ready.
# Leave them empty and customers simply use the manual "pay and send your M-Pesa code" option.
# NEVER share this file, upload it, or put it in a zip. Keep the keys secret.
# ---------------------------------------------------------------------------
MPESA_ENV=sandbox                        # "sandbox" while testing, "production" when you go live
MPESA_CONSUMER_KEY=                      # Daraja app > Consumer Key
MPESA_CONSUMER_SECRET=                   # Daraja app > Consumer Secret
MPESA_SHORTCODE=                         # Your Paybill number, or your Till's HO / store number (sandbox: 174379)
MPESA_PASSKEY=                           # Lipa Na M-Pesa Online Passkey from Daraja
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # Paybill = CustomerPayBillOnline | Till (Buy Goods) = CustomerBuyGoodsOnline
MPESA_PARTYB=                            # Only for a Till: the Till number. Leave empty for a Paybill.
MPESA_CALLBACK_BASE_URL=https://your-site.netlify.app   # Your PUBLIC https website address (Safaricom cannot reach localhost)
MPESA_CALLBACK_SECRET=                   # Make up a long random string (at least 24 letters/numbers). It protects the callback address.
MPESA_CALLBACK_IP_ALLOWLIST=false        # Set to true once live to accept callbacks only from Safaricom's servers
# MPESA_ALLOWED_IPS=                     # Optional: comma-separated Safaricom IPs, if you want to use your own list
