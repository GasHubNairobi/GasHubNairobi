# ===========================================================================
# GasHub environment variables
#   Local:   copy this file to ".env" (never commit, zip or share it).
#   Netlify: add each of these in  Site configuration -> Environment variables  (do NOT upload a .env file).
#            Tick "Contains secret values" for every password / key / secret.
# ===========================================================================

# ---- Supabase (PostgreSQL) ---------------------------------------------------
# On Netlify use Supabase's CONNECTION POOLER (Supabase dashboard -> Connect -> "Transaction pooler"):
#   DB_HOST = aws-0-<region>.pooler.supabase.com     DB_PORT = 6543     DB_USER = postgres.<your-project-ref>
# Alternatively set DATABASE_URL to the full pooler connection string and leave DB_HOST/PORT/USER/PASSWORD out.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_HOST=your-supabase-pooler-host
DB_PORT=6543
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_NAME=postgres

# Verified (safe) database connection - RECOMMENDED. Supabase dashboard -> Project Settings -> Database -> SSL Configuration ->
# "Download certificate". Turn the file into one line and paste it here:   base64 -w0 prod-ca-2021.crt   (Windows PowerShell:
# [Convert]::ToBase64String([IO.File]::ReadAllBytes("prod-ca-2021.crt")) ). Test it on a deploy preview first: a wrong
# certificate stops the site from reaching the database. Without it the connection is encrypted but the server is not verified.
# DB_SSL_CA_BASE64=
# DB_SSL_CHECK_HOSTNAME=false   # set true to also require the certificate's host name to match

# ---- Security (REQUIRED) -----------------------------------------------------
# At least 32 random characters (the server refuses to start in production with a short or placeholder value). Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# One-time password for unlocking Super Admin settings the first time (10+ characters). Set it, redeploy, unlock, choose your own
# password in Settings, then DELETE this variable.
# SUPER_ADMIN_LOCK_PASSWORD=

# ---- Your public website address (REQUIRED) ----------------------------------
# Used in emails, share previews, social sign-in redirects and delivery links. No trailing slash. Both must be the same address.
PUBLIC_URL=https://your-site.netlify.app
APP_BASE_URL=https://your-site.netlify.app
# Local only:
PORT=3000
NODE_ENV=development

# ---- Cloudinary (product photos and dealer logos) ----------------------------
# Photos are uploaded to Cloudinary and only the short link is saved in the database (keeps /api/products small and fast).
# Cloudinary dashboard -> Settings -> API Keys. Leave the key and secret empty to keep storing photos in the database as before.
# On Netlify: tick "Contains secret values" for CLOUDINARY_API_SECRET.
CLOUDINARY_CLOUD_NAME=nqozhnp7
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (SMTP) ------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=GasHub <no-reply@example.com>

# ---- SMS (Africa's Talking) - optional ---------------------------------------
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false

# ---- Social sign-in - optional -----------------------------------------------
# Redirect URI to register in each console:  https://<your-site>/api/auth/<google|facebook|x>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REQUEST_EMAIL=false

# ---------------------------------------------------------------------------
# M-PESA (Safaricom Daraja) - phone prompt (STK Push) and typed-code checking
# Leave empty to keep the manual "pay, then send your M-Pesa code" option only.
# ---------------------------------------------------------------------------
MPESA_ENV=sandbox                        # "sandbox" while testing, "production" when live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                         # Paybill number, or the Till's HO / store number (sandbox: 174379)
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # Paybill = CustomerPayBillOnline | Till = CustomerBuyGoodsOnline
MPESA_PARTYB=                            # Till only: the till number
MPESA_CALLBACK_BASE_URL=https://your-site.netlify.app   # public HTTPS address, no trailing slash
MPESA_CALLBACK_SECRET=                   # 24+ random characters; becomes part of every callback address
MPESA_C2B_ENABLED=false                  # true = also verify typed M-Pesa codes (run: node backend/scripts/register-mpesa-c2b.js once)
MPESA_CALLBACK_IP_ALLOWLIST=false        # true = accept callbacks only from Safaricom's IP addresses
# MPESA_ALLOWED_IPS=                     # optional: your own comma-separated IP list

# ---- M-Pesa B2C (automatic withdrawal payouts to customers) - optional -------
# Result URL / Queue Timeout URL in Daraja:
#   <MPESA_CALLBACK_BASE_URL>/api/payments/mpesa/b2c/result/<MPESA_CALLBACK_SECRET>
#   <MPESA_CALLBACK_BASE_URL>/api/payments/mpesa/b2c/timeout/<MPESA_CALLBACK_SECRET>
# MPESA_B2C_INITIATOR_NAME=
# MPESA_B2C_SECURITY_CREDENTIAL=         # initiator password encrypted with Safaricom's certificate (base64)
# MPESA_B2C_SHORTCODE=                   # only if different from MPESA_SHORTCODE
# MPESA_B2C_COMMAND=BusinessPayment      # or SalaryPayment

# ---- Bank payment details shown to customers - optional ----------------------
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_PAYBILL=
BANK_INSTRUCTIONS=
BANK_API_ENABLED=false
BANK_API_BASE_URL=
BANK_API_KEY=

# ---- Account customer withdrawals are paid FROM - optional --------------------
# (anything saved in Admin > Withdrawals takes priority). TYPE: mpesa_phone | paybill | till | bank
GASHUB_WITHDRAWAL_ACCOUNT_TYPE=paybill
GASHUB_WITHDRAWAL_ACCOUNT_NUMBER=
GASHUB_WITHDRAWAL_ACCOUNT_NAME=GasHub
GASHUB_WITHDRAWAL_ACCOUNT_REFERENCE=
